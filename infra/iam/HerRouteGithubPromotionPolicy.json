{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadProjectBucketLocation",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::herroute-627511992462-eu-central-1"
    },
    {
      "Sid": "ListCandidateAndPromotionPrefixes",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::herroute-627511992462-eu-central-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "candidates/*",
            "staging/segment_features/*",
            "athena-results/*",
            "warehouse/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadCandidateAndManageWarehouseOutputs",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::herroute-627511992462-eu-central-1/candidates/*",
        "arn:aws:s3:::herroute-627511992462-eu-central-1/staging/segment_features/*",
        "arn:aws:s3:::herroute-627511992462-eu-central-1/athena-results/*",
        "arn:aws:s3:::herroute-627511992462-eu-central-1/warehouse/*"
      ]
    },
    {
      "Sid": "UseHerRouteGlueObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "glue:BatchCreatePartition", "glue:BatchDeletePartition", "glue:CreateTable",
        "glue:GetDatabase", "glue:GetDatabases", "glue:GetPartitions", "glue:GetTable",
        "glue:GetTables", "glue:GetTableVersions", "glue:UpdateTable"
      ],
      "Resource": [
        "arn:aws:glue:eu-central-1:627511992462:catalog",
        "arn:aws:glue:eu-central-1:627511992462:database/herroute",
        "arn:aws:glue:eu-central-1:627511992462:table/herroute/*"
      ]
    },
    {
      "Sid": "UseHerRouteAthenaWorkgroupOnly",
      "Effect": "Allow",
      "Action": [
        "athena:GetQueryExecution", "athena:GetQueryResults", "athena:GetWorkGroup",
        "athena:ListQueryExecutions", "athena:StartQueryExecution", "athena:StopQueryExecution"
      ],
      "Resource": "arn:aws:athena:eu-central-1:627511992462:workgroup/herroute"
    }
  ]
}
